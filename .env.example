PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patient_visit_billing
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
FRONTEND_ORIGIN=http://localhost:5173

# The NUMBER of reverse proxies in front of this server (1 for nginx, 2 for Cloudflare plus nginx). Leave empty when there is none.
# Never use "true". Check it in Super Admin > Network check.
TRUST_PROXY=
# Online booking security check (Cloudflare Turnstile). Both are needed in production, otherwise online booking stays off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
