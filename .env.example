PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patient_visit_billing
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
FRONTEND_ORIGIN=http://localhost:5173

# The NUMBER of reverse proxies in front of this server (1 for nginx, 2 for Cloudflare plus nginx). Leave empty when there is none.
# Never use "true". Check it in Super Admin > Network check.
TRUST_PROXY=
# Online booking security check (Cloudflare Turnstile). Both are needed in production, otherwise online booking stays off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# WhatsApp messages through the Meta Cloud API. Sending is turned on and paused by the Super Admin (Pricing > WhatsApp messages).
# The token (system user, no expiry) and the phone number ID come from Meta; never put them in code or share them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The language the templates were approved in: en for "English", en_US for "English (US)", en_GB for "English (UK)". Default en.
WHATSAPP_TEMPLATE_LANGUAGE=en
# !!! Outside production, real messages go ONLY to these numbers (comma separated); empty = NOBODY gets a message.
# On production leave it empty (patients get their messages; NODE_ENV=production is required).
# Development: put only the owner's own test phone here, never a patient number.
WHATSAPP_TEST_NUMBERS=
